# =============================================================================
# Demand Forecasting System — environment template
# Copy to .env and replace every CHANGE_ME value before running locally.
# Never commit .env. Docker Compose reads this file automatically.
# =============================================================================

# --- Application ---
APP_NAME=demand-forecasting-system
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_DIR=logs
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
ALLOWED_HOSTS=localhost,127.0.0.1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_RATE_LIMIT_PER_MINUTE=120
API_CACHE_TTL_SECONDS=60
API_REQUEST_TIMEOUT_SECONDS=30

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=forecast
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=demand_forecasting
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=demand-forecasting
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Data ---
DATA_RAW_PATH=retail_store_inventory.csv
DATA_PROCESSED_DIR=data/processed
DATA_FEATURES_DIR=data/features
DATA_DATE_COLUMN=Date
FORECAST_HORIZON_DAYS=14
RANDOM_SEED=42

# --- Models ---
MODEL_ARTIFACT_DIR=models/artifacts
MODEL_DEFAULT_ALGORITHM=ensemble
MODEL_TEST_SIZE_DAYS=28

# --- Monitoring ---
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
ALERT_WEBHOOK_URL=
DRIFT_PSI_THRESHOLD=0.2
DRIFT_KL_THRESHOLD=0.1

# --- Airflow (docker-compose profile "airflow") ---
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET_KEY_32_URLSAFE_BASE64
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_EMAIL=airflow@example.com

# --- Optional object storage (MLflow artifacts in production) ---
S3_BUCKET=
S3_REGION=us-east-1
